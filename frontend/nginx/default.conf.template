# Satlab web: the built SPA under /satlab/, and same-origin proxies to the API with the /satlab
# prefix stripped (the API's own routes are /api and /ws). Rendered by the nginx image's envsubst
# at start-up: only ${SATLAB_API_UPSTREAM} is substituted (default http://ca-satlab-api, the API's
# internal name in the Azure Container Apps environment).

# The client's IP: ACA's ingress appends it to X-Forwarded-For. Trust only private/CGNAT hops,
# so the rightmost untrusted address wins and a client can't spoof it by sending the header.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 100.64.0.0/10;
set_real_ip_from 127.0.0.1;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

limit_req_zone $binary_remote_addr zone=satlab_api:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=satlab_ws:10m;
limit_req_status 429;
limit_conn_status 429;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    # Behind ACA's TLS ingress nginx sees plain http on :8080: keep redirects relative.
    absolute_redirect off;
    client_max_body_size 64k;
    charset utf-8;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = / {
        return 302 /satlab/;
    }

    location = /satlab {
        return 301 /satlab/;
    }

    # Content-hashed bundles: cache forever.
    location /satlab/assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;

        # nginx's mime.types doesn't know .mjs (MapLibre's module worker). Served as
        # octet-stream with nosniff, the browser refuses to start the worker and the map breaks.
        location ~ \.mjs$ {
            types { }
            default_type text/javascript;
            try_files $uri =404;
        }
    }

    # Cesium's workers and assets (the 3D globe). Not content-hashed, so cached for a day only; a
    # missing file is a 404, never the SPA page (a worker served as HTML fails obscurely).
    location /satlab/cesium/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    location /satlab/api/ {
        limit_req zone=satlab_api burst=40 nodelay;
        proxy_pass ${SATLAB_API_UPSTREAM}/api/;
        proxy_http_version 1.1;
        # ACA routes by Host, so the upstream's own name ($proxy_host, the default) must be kept.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location /satlab/ws/ {
        limit_conn satlab_ws 4;
        proxy_pass ${SATLAB_API_UPSTREAM}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Origin passes through untouched: the API checks it against SATLAB_CORS_ORIGINS.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # The SPA: unknown paths under /satlab/ get index.html; it must always be revalidated.
    location /satlab/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /satlab/index.html;
    }

    location / {
        return 404;
    }
}
