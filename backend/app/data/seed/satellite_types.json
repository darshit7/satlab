{
  "_comment": "Satellite type classification for the visible-set filters. Ordered rules; the first match wins and anything unmatched is 'other'. Patterns are case-insensitive regexes searched in the Celestrak object name; norad_ids match exactly. Debris and rocket bodies (e.g. 'FENGYUN 1C DEB', 'CZ-4C R/B', fetched by a remote search) are caught first. Applied on every catalog ingest and re-applied to the whole catalog at startup, so editing this file reclassifies existing rows. Watch the traps (covered in tests/test_classify.py): SENTINEL-2/3/5P/6 are not SAR, SARAL is an altimeter, GSAT0xxx is Galileo but GSAT-xx is ISRO comms, 'ISS OBJECT xx' are deployed cubesats/debris, and GLONASS flies as 'COSMOS nnnn [GLONASS-M]'.",
  "rules": [
    {
      "type": "other",
      "is_sar_capable": false,
      "patterns": ["\\bDEB\\b", "\\bR/B\\b", "\\bAKM\\b"],
      "norad_ids": []
    },
    {
      "type": "sar",
      "is_sar_capable": true,
      "patterns": [
        "^SENTINEL-1[A-Z]\\b",
        "^UMBRA-",
        "^ICEYE-",
        "^CAPELLA-",
        "^RADARSAT",
        "^RCM-\\d",
        "^TERRASAR-X",
        "^TANDEM-X",
        "^PAZ$",
        "^COSMO-SKYMED",
        "^CSG-\\d",
        "^ALOS-[24]\\b",
        "^SAOCOM",
        "^NISAR\\b",
        "\\bKOMPSAT-5\\b",
        "^RISAT",
        "^GAOFEN-3\\b",
        "^STRIX-",
        "^QPS-SAR",
        "^NOVASAR",
        "^KONDOR-FKA",
        "^SAR-LUPE",
        "^CARBSAR$",
        "^PIESAT"
      ],
      "norad_ids": []
    },
    {
      "type": "station",
      "is_sar_capable": false,
      "patterns": [
        "^ISS \\(",
        "^CSS \\(",
        "^SOYUZ-MS",
        "^PROGRESS-MS",
        "^SHENZHOU",
        "^TIANZHOU",
        "^CREW DRAGON",
        "^DRAGON CRS",
        "^CYGNUS",
        "^HTV-X"
      ],
      "norad_ids": []
    },
    {
      "type": "weather",
      "is_sar_capable": false,
      "patterns": [
        "^NOAA \\d",
        "^METOP-",
        "\\bGOES \\d",
        "^EWS-",
        "^FENGYUN",
        "^METEOR-M",
        "^HIMAWARI",
        "^ELEKTRO-L",
        "^ARKTIKA-M",
        "^INSAT-3D",
        "^DMSP",
        "^METEOSAT",
        "^MTG-",
        "^GEO-KOMPSAT-2A",
        "^SUOMI NPP"
      ],
      "norad_ids": []
    },
    {
      "type": "navigation",
      "is_sar_capable": false,
      "patterns": [
        "^NAVSTAR",
        "GLONASS",
        "^GSAT0\\d",
        "GALILEO",
        "^BEIDOU",
        "^IRNSS",
        "^NVS-",
        "^QZS-"
      ],
      "norad_ids": []
    },
    {
      "type": "comms",
      "is_sar_capable": false,
      "patterns": [
        "^STARLINK",
        "^ONEWEB",
        "^KUIPER",
        "^QIANFAN",
        "^HULIANWANG",
        "^IRIDIUM",
        "^GLOBALSTAR",
        "^ORBCOMM",
        "^INTELSAT",
        "^EUTELSAT",
        "^SES[- ]",
        "^INMARSAT",
        "^VIASAT",
        "^ECHOSTAR",
        "^GALAXY",
        "^TDRS",
        "^ASTRA",
        "^GSAT-",
        "^O3B",
        "^SKYNET",
        "^WGS",
        "^MUOS",
        "^AEHF",
        "^YAMAL",
        "^EXPRESS-",
        "^LUCH",
        "^GONETS",
        "^TELKOM",
        "^ARABSAT",
        "^NILESAT",
        "^TURKSAT",
        "^AMAZONAS",
        "^HISPASAT",
        "^THAICOM",
        "^JCSAT",
        "^APSTAR",
        "^ASIASAT",
        "^CHINASAT",
        "^ZHONGXING",
        "^TIANLIAN",
        "^KINEIS",
        "COMSAT"
      ],
      "norad_ids": []
    }
  ]
}
