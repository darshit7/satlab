    "uwe4": {
      "telemetry": [
        {
          "name": "hk",
          "label": "Housekeeping beacon",
          "framing": { "type": "ax25", "fcs": false },
          "payload": {
            "encoding": "binary",
            "endian": "le",
            "fields": [
              { "name": "flags1", "type": "u8", "format": "hex" },
              { "name": "flags2", "type": "u8", "format": "hex" },
              { "name": "packet_id", "type": "u16" },
              { "name": "from_system", "type": "u8", "match": 2 },
              { "name": "from_subsystem", "type": "u8", "match": 1 },
              { "name": "to_system", "type": "u8", "match": 1 },
              { "name": "to_subsystem", "type": "u8", "match": 0 },
              { "name": "api", "type": "u8", "match": 14 },
              { "name": "payload_size", "type": "u8", "match": 46 },
              { "name": "command", "type": "u8" },
              { "name": "var_id", "type": "u16" },
              { "name": "type_and_length", "type": "u16" },
              { "name": "timestamp", "type": "u48", "format": "unix_time" },
              { "name": "beacon_period_s", "type": "u32", "scale": 0.0009765625, "unit": "s" },
              { "name": "values_out_of_range", "type": "u16" },
              { "name": "uptime_s", "type": "u32", "unit": "s" },
              { "name": "subsystem_status", "type": "u16", "format": "hex" },
              { "name": "batt_a_temp_c", "type": "s8", "unit": "°C" },
              { "name": "batt_a_soc_pct", "type": "s8", "unit": "%" },
              { "name": "batt_b_temp_c", "type": "s8", "unit": "°C" },
              { "name": "batt_b_soc_pct", "type": "s8", "unit": "%" },
              { "name": "batt_a_current_ma", "type": "s16", "unit": "mA" },
              { "name": "batt_a_voltage_mv", "type": "s16", "unit": "mV" },
              { "name": "batt_b_current_ma", "type": "s16", "unit": "mA" },
              { "name": "batt_b_voltage_mv", "type": "s16", "unit": "mV" },
              { "name": "power_consumption_mw", "type": "s16", "unit": "mW" },
              { "name": "obc_temp_c", "type": "s8", "unit": "°C" },
              { "name": "panel_pos_x_temp_c", "type": "s8", "unit": "°C" },
              { "name": "panel_neg_x_temp_c", "type": "s8", "unit": "°C" },
              { "name": "panel_pos_y_temp_c", "type": "s8", "unit": "°C" },
              { "name": "panel_neg_y_temp_c", "type": "s8", "unit": "°C" },
              { "name": "panel_pos_z_temp_c", "type": "s8", "unit": "°C" },
              { "name": "panel_neg_z_temp_c", "type": "s8", "unit": "°C" },
              { "name": "frequency_khz", "type": "u16", "offset": 400000, "unit": "kHz" },
              { "name": "checksum", "type": "u16", "format": "hex" }
            ]
          },
          "interval_s": 30,
          "downlink": "satnogs",
          "layout_sourced": true,
          "sources": [
            { "title": "UWE-4 decoder used by SatNOGS (satnogs-decoders, uwe4.ksy)", "url": "https://gitlab.com/librespacefoundation/satnogs/satnogs-decoders/-/blob/master/ksy/uwe4.ksy" },
            { "title": "UWE-4 in the SatNOGS DB", "url": "https://db.satnogs.org/satellite/WDIT-2736-3800-1720-7555" }
          ]
        }
      ],
