# =====================================================================
# Satlab — monorepo .gitignore
#   backend/  : Python 3.12 · uv · FastAPI · SQLAlchemy/Alembic · pytest/ruff
#   frontend/ : React · TypeScript · Vite · pnpm · vitest/oxlint
# Commit lockfiles (backend/uv.lock, frontend/pnpm-lock.yaml) for reproducible installs.
# =====================================================================

# ---------------------------------------------------------------------
# Secrets & local environment (AGENTS.md golden rule 8)
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
.envrc

# ---------------------------------------------------------------------
# OS / editor cruft
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
*.code-workspace
*.sublime-workspace

# ---------------------------------------------------------------------
# Project runtime data (disposable; never commit)
# ---------------------------------------------------------------------
# SQLite dev DB, Celestrak TLE cache, future SAR rasters/downloads
backend/var/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Large rasters stay out of git as well as the DB (golden rule 9)
*.tif
*.tiff
*.nc
*.zarr/

# =====================================================================
# Python (backend/)
# =====================================================================
__pycache__/
*.py[codz]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version.local

# Packaging / build artifacts — anchored to backend/ so they don't
# swallow frontend paths such as frontend/src/lib/
backend/build/
backend/dist/
backend/lib/
backend/lib64/
backend/sdist/
backend/wheels/
backend/develop-eggs/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/parts/
backend/share/python-wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Test / coverage / type-check / lint caches
.pytest_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py.cover
nosetests.xml
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter (SAR experiments)
.ipynb_checkpoints/
profile_default/
ipython_config.py

# Misc
.pypirc
celerybeat-schedule*
*.pid

# =====================================================================
# Node / React / Vite (frontend/)
# =====================================================================
node_modules/
.pnpm-store/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
*.tsbuildinfo
.vite/
.eslintcache
.stylelintcache

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Only pnpm is used — ignore other managers' lockfiles if created by accident
frontend/package-lock.json
frontend/yarn.lock

# =====================================================================
# Logs
# =====================================================================
logs/
*.log


# =====================================================================
# Miscellaneous
# =====================================================================
docs/
