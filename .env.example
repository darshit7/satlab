# Copy to `.env` (repo root or backend/) and adjust. `.env` is gitignored — never commit secrets.
# All values below are optional; defaults are shown.

# ---------- backend (prefix SATLAB_) ----------
# SATLAB_DATABASE_URL=sqlite:////abs/path/satlab.db      # default: <repo>/backend/var/satlab.db
# SATLAB_AUTO_MIGRATE=true                              # run `alembic upgrade head` on startup
# SATLAB_CACHE_DIR=/abs/path/cache                      # default: <repo>/backend/var/cache (TLE cache, offline fallback)
# SATLAB_CORS_ORIGINS=["http://localhost:5173"]

# Celestrak GP data. Celestrak asks clients not to re-download a group more than every ~2 h.
# SATLAB_CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
# SATLAB_CATALOG_GROUP=active
# SATLAB_CATALOG_AUTOLOAD=true
# SATLAB_CATALOG_MAX_AGE_HOURS=12

# Simulation loop
# SATLAB_TICK_HZ=2
# SATLAB_MAX_TRACKED=25
# SATLAB_MAX_TIME_SCALE=3600
# SATLAB_GROUND_TRACK_POINTS=240
# SATLAB_SESSION_IDLE_GRACE_S=60

# Visibility & passes
# SATLAB_HORIZON_MASK_DEG=5                             # "in view" / AOS / LOS threshold, every station
# SATLAB_PASS_SEARCH_STEP_S=30                          # coarse grid of the pass search (refined after)
# SATLAB_PASS_ARC_POINTS=48                             # samples per sky arc
# SATLAB_MAX_ARCS_PER_TICK=100                          # sky arcs computed per tick (rest wait a tick)
# SATLAB_UPCOMING_WINDOW_MIN=90                         # rising-soon sweep window
# SATLAB_UPCOMING_STEP_S=60
# SATLAB_UPCOMING_CHUNK_SIZE=500                        # satellites per tick while the list is computing
# SATLAB_UPCOMING_MAX_TIME_SCALE=60                     # above this the rising-soon list pauses
# SATLAB_UPCOMING_LIMIT=100                             # rising-soon entries sent (soonest first)

# ---------- frontend (put these in frontend/.env.local) ----------
# VITE_MAP_STYLE_URL_LIGHT=https://tiles.openfreemap.org/styles/positron
# VITE_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
# VITE_MAP_LABEL_FONT=Noto Sans Regular
# SATLAB_BACKEND_URL=http://localhost:8000              # Vite dev proxy target
# NEXT_UMAMI_ID=<uuid>                                  # Umami Cloud website ID; injected into production builds only.
#                                                       # Public by design (it ends up in the HTML), not a secret.
