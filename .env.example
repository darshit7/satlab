# Copy to `.env` (repo root or backend/) and adjust. `.env` is gitignored — never commit secrets.
# All values below are optional; defaults are shown.

# ---------- backend (prefix SATLAB_) ----------
# Database: Neon Postgres, one branch per stage (full setup: deploy/neon.md). Postgres URLs contain
# passwords — SECRET; they live only in these gitignored files or the platform's secret store:
#   .env             local dev  → `dev` branch:  the two lines below (app role pooled, owner direct)
#   .env.test        pytest     → `test` branch: SATLAB_TEST_POSTGRES_URL only (owner, direct host)
#   .env.production  prod migrations only        (`uv run --env-file ../.env.production alembic upgrade head`)
# Without a database URL the backend falls back to SQLite at <repo>/backend/var/satlab.db.
# SATLAB_DATABASE_URL=postgresql://satlab_app:<password>@<endpoint>-pooler.<region>.<cloud>.neon.tech/neondb?sslmode=require&channel_binding=require
# Alembic only — the schema owner on the direct (non-pooled) host. Defaults to SATLAB_DATABASE_URL.
# Never given to the production app.
# SATLAB_MIGRATION_DATABASE_URL=postgresql://neondb_owner:<password>@<endpoint>.<region>.<cloud>.neon.tech/neondb?sslmode=require&channel_binding=require
# SATLAB_AUTO_MIGRATE=true                              # run `alembic upgrade head` on startup (false in production)
# In .env.test (or the shell) — never in .env:
# SATLAB_TEST_POSTGRES_URL=postgresql://neondb_owner:<password>@<endpoint>.<region>.<cloud>.neon.tech/neondb?sslmode=require&channel_binding=require
# SATLAB_CACHE_DIR=/abs/path/cache                      # default: <repo>/backend/var/cache (TLE cache, offline fallback)
# SATLAB_CORS_ORIGINS=["http://localhost:5173"]       # CORS + WebSocket Origin allow-list
# SATLAB_DOCS_ENABLED=true                              # /docs, /redoc, /openapi.json (false in production)

# Public-exposure limits
# SATLAB_MAX_ACTIVE_SESSIONS=10                         # live sessions at once (each propagates the catalog)
# SATLAB_WS_AUTH_TIMEOUT_S=5                            # time for a socket's first message, `auth {token}`
# SATLAB_WS_MESSAGES_PER_S=20                           # per-connection client message rate…
# SATLAB_WS_MESSAGE_BURST=40                            # …and burst; over it the socket is closed (1008)
# SATLAB_REMOTE_SEARCH_PER_MIN=10                       # Celestrak searches and single-satellite fetches, all clients together

# Celestrak GP data. It updates every 2 h and refuses (HTTP 403) a repeat download before then.
# SATLAB_CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
# SATLAB_CATALOG_GROUP=active
# SATLAB_CATALOG_AUTOLOAD=true
# SATLAB_CATALOG_MAX_AGE_HOURS=12                       # at least 2
# SATLAB_CATALOG_REFRESH_CHECK_MINUTES=30              # how often the catalog's age is checked (at least 5)
# SATLAB_CELESTRAK_MAX_BYTES=16777216                   # largest Celestrak response read
# SATLAB_HTTP_TIMEOUT_S=30                              # every upstream request (Celestrak, SatNOGS)

# Simulation loop
# SATLAB_TICK_HZ=2
# SATLAB_MAX_TRACKED=25
# SATLAB_MAX_TIME_SCALE=3600
# SATLAB_GROUND_TRACK_POINTS=240
# SATLAB_SESSION_IDLE_GRACE_S=60

# Visibility & passes
# SATLAB_HORIZON_MASK_DEG=5                             # "in view" / AOS / LOS threshold, every station
# SATLAB_PASS_SEARCH_STEP_S=30                          # coarse grid of the pass search (refined after)
# SATLAB_PASS_ARC_POINTS=48                             # samples per sky arc
# SATLAB_MAX_ARCS_PER_TICK=100                          # sky arcs computed per tick (rest wait a tick)
# SATLAB_UPCOMING_WINDOW_MIN=90                         # rising-soon sweep window
# SATLAB_UPCOMING_STEP_S=60
# SATLAB_UPCOMING_CHUNK_SIZE=500                        # satellites per tick while the list is computing
# SATLAB_UPCOMING_MAX_TIME_SCALE=60                     # above this the rising-soon list pauses
# SATLAB_UPCOMING_LIMIT=100                             # rising-soon entries sent (soonest first)

# Link budget and health
# SATLAB_LINK_GREEN_MARGIN_DB=6                         # link margin above this is green
# SATLAB_LINK_AMBER_MARGIN_DB=0                         # amber from here up to green; red below (or below the mask)
# SATLAB_SUBSYSTEM_LOOKBACK_H=24                        # subsystem health is integrated over this much sim time
# SATLAB_SUBSYSTEM_STEP_S=60                            # on this grid

# Communications (uplink is simulated: nothing is ever transmitted)
# SATLAB_COMMS_MAX_TIME_SCALE=60                        # above this the contact pauses
# SATLAB_COMMS_MAX_PACKETS_PER_TICK=4                   # beacons emitted per tick (the rest are skipped)
# SATLAB_COMMANDS_PER_MIN=30                            # per session, on top of the WS message limit
# SATLAB_MAX_COMMANDS_PER_SESSION=500                   # stored commands per session
# SATLAB_MAX_TELEMETRY_FRAMES_PER_SESSION=5000          # stored frames per session (more still stream)
# SATLAB_COMMS_RETENTION_DAYS=7                         # comms rows of ended sessions are purged after this
# SATLAB_SCHEDULE_LEAD_S=60                             # pass automation takes the antenna this long before AOS
# SATLAB_SCHEDULE_HORIZON_H=24                          # how far ahead a command can be booked for a pass
# SATLAB_MAX_SCHEDULED_COMMANDS=20                      # commands waiting for a pass, per session

# SatNOGS DB: real archived frames, replayed during passes. A free account at db.satnogs.org gives
# an API token (Settings → API key) — SECRET: only in .env or the platform's secret store. Without
# it, replay is off and the app says so. Tests always run without it.
# SATLAB_SATNOGS_API_TOKEN=<token>
# SATLAB_SATNOGS_DB_URL=https://db.satnogs.org/api/telemetry/
# SATLAB_SATNOGS_REFRESH_HOURS=6                        # per satellite; SatNOGS rate-limits hard
# SATLAB_SATNOGS_MAX_FRAMES=200                         # kept per satellite
# SATLAB_SATNOGS_MAX_PAGES=5                            # per refresh and satellite
# SATLAB_SATNOGS_REQUESTS_PER_MIN=6                     # all satellites together; a 429 backs off

# SAR imagery: real Sentinel-1 RTC scenes from Microsoft Planetary Computer (STAC + anonymous SAS
# tokens; no account needed). Scenes are read as bounded windows by one worker process; crops and
# images are an ephemeral cache under SATLAB_SAR_STORAGE_DIR, recomputed when missing.
# SATLAB_SAR_ENABLED=true
# SATLAB_SAR_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
# SATLAB_SAR_TOKEN_URL=https://planetarycomputer.microsoft.com/api/sas/v1/token
# SATLAB_SAR_SUBSCRIPTION_KEY=<key>                     # optional, SECRET: only relaxes MPC rate limits
# SATLAB_SAR_BLOB_ACCOUNT=sentinel1euwestrtc            # the only storage account scenes are read from
# SATLAB_SAR_BLOB_CONTAINER=sentinel1-grd-rtc           # the only container
# SATLAB_SAR_STORAGE_DIR=/abs/path/sar                  # default: <repo>/backend/var/sar
# SATLAB_SAR_STORAGE_MAX_BYTES=1073741824               # cache cap; least recently used goes first
# SATLAB_SAR_STAC_MAX_BYTES=4194304                     # largest STAC/token response read
# SATLAB_SAR_UPSTREAM_REQUESTS_PER_MIN=30               # STAC + token requests, all clients together
# SATLAB_SAR_SEARCH_CACHE_MINUTES=15
# SATLAB_SAR_SEARCHES_PER_MIN=6                         # per session
# SATLAB_SAR_COMPARISONS_PER_HOUR=6                     # per session, recomputes included
# SATLAB_SAR_COMPARISONS_PER_HOUR_TOTAL=30              # all sessions together
# SATLAB_SAR_MAX_COMPARISONS_PER_SESSION=12
# SATLAB_SAR_QUEUE_MAX=4                                # waiting for the worker, all sessions
# SATLAB_SAR_JOB_TIMEOUT_S=240                          # one comparison; then the worker is stopped
# SATLAB_SAR_READ_TIMEOUT_S=30                          # each GDAL HTTP request
# SATLAB_SAR_WORKER_NICE=10                             # the worker's priority below the API's
# SATLAB_SAR_GDAL_CACHE_MB=64

# ---------- frontend (put these in frontend/.env.local) ----------
# VITE_MAP_STYLE_URL_LIGHT=https://tiles.openfreemap.org/styles/positron
# VITE_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
# VITE_MAP_LABEL_FONT=Noto Sans Regular
# SATLAB_BACKEND_URL=http://localhost:8000              # Vite dev proxy target
# SATLAB_DOCS_URL=http://127.0.0.1:8001                 # Vite dev proxy target for /satlab/docs/ (sphinx-autobuild)
# SATLAB_API_UPSTREAM=http://ca-satlab-api              # web container (nginx) → API; http://api:8000 locally
# NEXT_UMAMI_ID=<uuid>                                  # Umami Cloud website ID; injected into production builds only.
#                                                       # Public by design (it ends up in the HTML), not a secret.
